# API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
GROQ_API_KEY=gsk_xxx
EXA_API_KEY=xxx
MEM0_API_KEY=xxx

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_KEY=xxx

# Redis
REDIS_URL=redis://localhost:6379

# ElevenLabs
ELEVENLABS_API_KEY=xxx

# Market Data
MARKET_DATA_PROVIDER=yfinance
ALPHA_VANTAGE_API_KEY=your_key_here

# Security
JWT_SECRET=dev_only_change_me_in_production

# Environment
NODE_ENV=development
PYTHON_ENV=development

# Testing Flags
ENABLE_API_CALLS=true
USE_MOCK_LLM=false
USE_MOCK_MARKET_DATA=false
USE_MOCK_EXA=false

# Rate Limiting
ENABLE_RATE_LIMITING=true
EXA_CALLS_PER_HOUR=500
OPENAI_CALLS_PER_HOUR=1000
GROQ_CALLS_PER_HOUR=2000

# Cost Tracking
ENABLE_COST_TRACKING=true
COST_ALERT_THRESHOLD_USD=100.0

# Cache TTL (seconds)
CACHE_TTL_NEWS=14400
CACHE_TTL_FILING=2592000
CACHE_TTL_RESEARCH=604800

# Market Hours
ENABLE_MARKET_HOURS_CHECK=true
MONITOR_ONLY_DURING_MARKET_HOURS=true

# Model Versions
ROUTER_VERSION=v1.0
RECOMMENDATION_VERSION=v1.0
SUMMARIZER_VERSION=v1.0

# Compliance
ENABLE_DISCLAIMERS=true

